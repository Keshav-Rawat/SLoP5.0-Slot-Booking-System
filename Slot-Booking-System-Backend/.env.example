# Server Configuration
# Set to 'production' when deploying
NODE_ENV=production
PORT=5000

# MongoDB Connection
# Local dev: mongodb://localhost:27017/slot-booking-system
# Atlas (production): mongodb+srv://<user>:<password>@cluster.mongodb.net/?appName=...
MONGODB_URI=mongodb://localhost:27017/slot-booking-system

# JWT Authentication
# Generate a strong secret: https://randomkeygen.com (use "Fort Knox Passwords")
JWT_SECRET=replace-this-with-a-strong-random-secret
JWT_EXPIRE=7d

# Frontend URL (for CORS — MUST match your deployed frontend origin exactly)
# Local dev: http://localhost:5173
# GitHub Pages: https://<your-github-username>.github.io
FRONTEND_URL=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Gmail SMTP — used for password reset emails
# Step-by-step setup:
#   1. Enable 2-Step Verification: https://myaccount.google.com/security
#   2. Create an App Password: https://myaccount.google.com/apppasswords
#      (App: Mail, Device: Other → name it "SLoP Backend")
#   3. Copy the 16-character password and paste it below (no spaces)
GMAIL_USER=your-gmail@gmail.com
GMAIL_PASS=your-16-char-app-password
# Optional: display name shown in From field
GMAIL_FROM="SLoP Booking System <your-gmail@gmail.com>"
